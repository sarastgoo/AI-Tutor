# =============================================================================
# AI English Tutor - Environment Variables
# =============================================================================
# Copy this to .env and adjust values.
# NEVER commit .env to git.
# =============================================================================

# --- Application ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
APP_VERSION=0.1.0
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Database ---
# Async URL (for FastAPI runtime)
DATABASE_URL=postgresql+asyncpg://tutor:devpassword@127.0.0.1:5432/tutor_dev

# Sync URL (for Alembic migrations)
DATABASE_URL_SYNC=postgresql+psycopg://tutor:devpassword@127.0.0.1:5432/tutor_dev

POSTGRES_USER=tutor
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=tutor_dev
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# --- Storage ---
# Absolute path to storage root (must exist)
STORAGE_ROOT=C:\Projects\ai-english-tutor\storage

# Allowlisted root for local import (P2+)
IMPORT_ROOT=C:\Projects\ai-english-tutor\scripts\fixtures

# --- Embeddings ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# --- OCR (P2+) ---
OCR_LANG=en
OCR_USE_GPU=false

# --- STT (P3+) ---
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- TTS (P6+) ---
PIPER_VOICE_PATH=C:\Projects\ai-english-tutor\scripts\voices\en_US-lessac-medium.onnx
PIPER_VOICE_CONFIG=C:\Projects\ai-english-tutor\scripts\voices\en_US-lessac-medium.onnx.json

# --- Security ---
# In dev, API refuses to bind to non-loopback addresses.
ALLOW_NON_LOOPBACK=false